// Helpers Components
function SidebarItem({ icon, label, active, onClick, accentText }) {
  return (
    <button 
      onClick={onClick}
      className={`w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all ${
        active 
          ? 'bg-violet-600/15 border border-violet-500/30 text-white shadow-sm' 
          : 'text-slate-400 hover:bg-slate-800/40 hover:text-slate-200'
      }`}
    >
      {React.cloneElement(icon, { className: `w-4 h-4 ${active ? accentText : ''}` })}
      {label}
    </button>
  );
}

function NavBtn({ icon, label, active, onClick, accentText }) {
  return (
    <button 
      onClick={onClick} 
      className={`flex flex-col items-center gap-0.5 p-1 transition-all ${active ? `${accentText} scale-110 font-bold` : 'text-slate-400'}`}
    >
      {React.cloneElement(icon, { className: 'w-5 h-5' })}
      <span className="text-[9px]">{label}</span>
    </button>
  );
}

