<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>BlueMoon Life App</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;
 font-family:Arial,"Noto Sans Thai",sans-serif;
 background:linear-gradient(135deg,#07152f,#35106b);
 color:#fff;
 min-height:100vh;
}
button,input,textarea{font:inherit}
button{
 border:0;
 border-radius:12px;
 padding:11px 16px;
 color:#fff;
 background:linear-gradient(135deg,#5264ff,#9b45ff);
 cursor:pointer;
}
button:hover{opacity:.85}
input,textarea{
 width:100%;
 background:#101a3b;
 color:#fff;
 border:1px solid #ffffff22;
 border-radius:12px;
 padding:12px;
 margin:6px 0;
}
textarea{min-height:100px;resize:vertical}

.layout{display:flex;min-height:100vh}
.sidebar{
 position:fixed;
 width:240px;
 height:100vh;
 padding:20px;
 background:#080d20eF;
 border-right:1px solid #ffffff15;
 z-index:5;
}
.logo{
 font-size:25px;
 font-weight:bold;
 text-align:center;
 margin:8px 0 25px;
}
.logo span{color:#a276ff}

.menu button{
 width:100%;
 text-align:left;
 background:transparent;
 margin:3px 0;
}
.menu button.active,
.menu button:hover{
 background:linear-gradient(90deg,#4f54e9,#9147e9);
}

.main{
 margin-left:240px;
 width:calc(100% - 240px);
 padding:20px;
 max-width:1400px;
}
.topbar{
 display:flex;
 justify-content:space-between;
 align-items:center;
 margin-bottom:20px;
}
.card{
 background:#ffffff0d;
 border:1px solid #ffffff14;
 border-radius:20px;
 padding:20px;
 margin-bottom:18px;
 backdrop-filter:blur(12px);
}
.grid{
 display:grid;
 grid-template-columns:repeat(auto-fit,minmax(190px,1fr));
 gap:15px;
}
.stat{
 padding:20px;
 border-radius:18px;
 background:linear-gradient(135deg,#3150c8,#763ed0);
}
.stat h2{font-size:30px;margin:8px 0}

.page{display:none}
.page.active{display:block}

.item{
 background:#ffffff0b;
 padding:14px;
 border-radius:13px;
 margin:8px 0;
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:10px;
}
.item.done span{text-decoration:line-through;opacity:.45}

.chatbox{
 height:350px;
 overflow:auto;
 padding:10px;
 background:#070d20;
 border-radius:15px;
}
.message{
 max-width:75%;
 background:#293154;
 padding:10px 14px;
 border-radius:15px;
 margin:8px 0;
}
.message.me{
 margin-left:auto;
 background:#654cf0;
}

.avatar{
 width:65px;
 height:65px;
 border-radius:50%;
 display:flex;
 align-items:center;
 justify-content:center;
 background:linear-gradient(135deg,#5160ff,#a247ff);
 font-size:30px;
}
.profile{
 display:flex;
 align-items:center;
 gap:15px;
}

.mobile{
 display:none;
}

.light{
 background:linear-gradient(135deg,#eef3ff,#eee5ff);
 color:#17172b;
}
.light .sidebar{background:#ffffffee}
.light .card{background:#ffffffaa}
.light input,.light textarea{background:#fff;color:#111}
.light .chatbox{background:#e7e9f5}
.light .message{background:#d4d7eb}

@media(max-width:700px){
 .sidebar{display:none}
 .sidebar.open{display:block}
 .main{
   margin-left:0;
   width:100%;
   padding:12px;
 }
 .mobile{display:block}
}
</style>
</head>

<body>

<div class="layout">

<aside class="sidebar" id="sidebar">
 <div class="logo">💙 Blue<span>Moon</span></div>

 <div class="menu">
  <button class="active" onclick="page('home',this)">🏠 หน้าหลัก</button>
  <button onclick="page('chat',this)">💬 แชต</button>
  <button onclick="page('friends',this)">👥 เพื่อน</button>
  <button onclick="page('todo',this)">✅ งาน</button>
  <button onclick="page('notes',this)">📝 โน้ต</button>
  <button onclick="page('calendar',this)">📅 ปฏิทิน</button>
  <button onclick="page('countdown',this)">⏳ Countdown</button>
  <button onclick="page('location',this)">📍 ตำแหน่ง</button>
  <button onclick="page('device',this)">🔋 อุปกรณ์</button>
  <button onclick="page('game',this)">🎮 เกม</button>
  <button onclick="page('profile',this)">👤 โปรไฟล์</button>
  <button onclick="theme()">🌙 เปลี่ยนธีม</button>
 </div>
</aside>

<main class="main">

<div class="topbar">
 <button class="mobile" onclick="menu()">☰</button>
 <h1 id="title">หน้าหลัก</h1>
 <span id="clock"></span>
</div>

<!-- HOME -->
<section id="home" class="page active">

<div class="card">
 <div class="profile">
  <div class="avatar">👤</div>
  <div>
   <h2 id="welcome">สวัสดี 👋</h2>
   <p>ยินดีต้อนรับเข้าสู่ BlueMoon</p>
  </div>
 </div>
</div>

<div class="grid">
 <div class="stat">💬 ข้อความ<h2 id="messages">0</h2></div>
 <div class="stat">👥 เพื่อน<h2 id="friends">0</h2></div>
 <div class="stat">✅ งานค้าง<h2 id="tasks">0</h2></div>
 <div class="stat">⭐ คะแนน<h2 id="score">0</h2></div>
</div>

</section>

<!-- CHAT -->
<section id="chat" class="page">
<div class="card">
<h2>💬 แชต</h2>

<div class="chatbox" id="chatbox"></div>

<input id="chatInput" placeholder="พิมพ์ข้อความ...">
<button onclick="send()">ส่ง</button>
<button onclick="clearChat()">ล้างแชต</button>
</div>
</section>

<!-- FRIENDS -->
<section id="friends" class="page">
<div class="card">
<h2>👥 เพื่อน</h2>
<input id="friendInput" placeholder="ชื่อเพื่อน">
<button onclick="addFriend()">เพิ่มเพื่อน</button>
<div id="friendList"></div>
</div>
</section>

<!-- TODO -->
<section id="todo" class="page">
<div class="card">
<h2>✅ To-do List</h2>
<input id="todoInput" placeholder="งานที่ต้องทำ">
<button onclick="addTodo()">เพิ่มงาน</button>
<div id="todoList"></div>
</div>
</section>

<!-- NOTES -->
<section id="notes" class="page">
<div class="card">
<h2>📝 โน้ต</h2>
<input id="noteTitle" placeholder="หัวข้อ">
<textarea id="noteText" placeholder="รายละเอียด"></textarea>
<button onclick="addNote()">บันทึก</button>
<div id="noteList"></div>
</div>
</section>

<!-- CALENDAR -->
<section id="calendar" class="page">
<div class="card">
<h2>📅 ปฏิทินกิจกรรม</h2>
<input type="date" id="eventDate">
<input id="eventText" placeholder="ชื่อกิจกรรม">
<button onclick="addEvent()">เพิ่มกิจกรรม</button>
<div id="eventList"></div>
</div>
</section>

<!-- COUNTDOWN -->
<section id="countdown" class="page">
<div class="card">
<h2>⏳ Countdown</h2>
<input type="datetime-local" id="targetDate">
<button onclick="startCountdown()">เริ่ม</button>
<h1 id="timer">00:00:00</h1>
</div>
</section>

<!-- LOCATION -->
<section id="location" class="page">
<div class="card">
<h2>📍 ตำแหน่งของฉัน</h2>
<p>กดปุ่มเพื่อขอสิทธิ์ตำแหน่งจากเบราว์เซอร์</p>
<button onclick="locationGPS()">เปิดตำแหน่ง</button>
<p id="gpsResult"></p>
</div>
</section>

<!-- DEVICE -->
<section id="device" class="page">
<div class="card">
<h2>🔋 ข้อมูลอุปกรณ์</h2>
<p id="battery">กำลังตรวจสอบแบตเตอรี่...</p>
<p>📱 หน้าจอ: <span id="screen"></span></p>
<p>🌐 เบราว์เซอร์: <span id="browser"></span></p>
<p>🕐 เวลา: <span id="deviceClock"></span></p>
</div>
</section>

<!-- GAME -->
<section id="game" class="page">
<div class="card">
<h2>🎮 เกมทายเลข</h2>
<p>ทายเลข 1–10</p>
<input id="guess" type="number" min="1" max="10">
<button onclick="guess()">ทาย</button>
<h3 id="gameResult"></h3>
</div>

<div class="card">
<h2>⭐ คะแนนของคุณ</h2>
<h1 id="gameScore">0</h1>
</div>
</section>

<!-- PROFILE -->
<section id="profile" class="page">
<div class="card">
<h2>👤 โปรไฟล์</h2>

<input id="name" placeholder="ชื่อ">
<input id="status" placeholder="สถานะ">

<button onclick="saveProfile()">บันทึก</button>

<div id="profileResult"></div>
</div>
</section>

</main>
</div>

<script>

/* DATABASE LOCAL */
const get=(key,def=[]) =>
 JSON.parse(localStorage.getItem(key)||JSON.stringify(def));

let friends=get("friends",[]);
let todos=get("todos",[]);
let notes=get("notes",[]);
let events=get("events",[]);
let chat=get("chat",[]);
let score=Number(localStorage.getItem("score")||0);

/* NAVIGATION */
function page(id,btn){
 document.querySelectorAll(".page")
 .forEach(x=>x.classList.remove("active"));

 document.getElementById(id).classList.add("active");

 document.querySelectorAll(".menu button")
 .forEach(x=>x.classList.remove("active"));

 if(btn)btn.classList.add("active");

 document.getElementById("title").textContent=btn
 ? btn.textContent.replace(/^.{2}/,"")
 : id;

 document.getElementById("sidebar").classList.remove("open");
}

function menu(){
 document.getElementById("sidebar").classList.toggle("open");
}

function theme(){
 document.body.classList.toggle("light");
 localStorage.setItem(
  "theme",
  document.body.classList.contains("light")?"light":"dark"
 );
}

if(localStorage.getItem("theme")==="light")
 document.body.classList.add("light");

/* CHAT */
function send(){
 const input=document.getElementById("chatInput");
 const text=input.value.trim();

 if(!text)return;

 chat.push({
  text:text,
  time:new Date().toLocaleTimeString("th-TH")
 });

 localStorage.setItem("chat",JSON.stringify(chat));

 input.value="";
 renderChat();
}

function renderChat(){
 const box=document.getElementById("chatbox");

 box.innerHTML=chat.map(x=>`
 <div class="message me">
 ${safe(x.text)}
 <small>${x.time}</small>
 </div>
 `).join("");

 document.getElementById("messages").textContent=chat.length;
}

function clearChat(){
 if(confirm("ล้างข้อความทั้งหมด?")){
  chat=[];
  localStorage.setItem("chat","[]");
  renderChat();
 }
}

/* FRIENDS */
function addFriend(){
 const input=document.getElementById("friendInput");
 const name=input.value.trim();

 if(!name)return;

 friends.push(name);
 localStorage.setItem("friends",JSON.stringify(friends));

 input.value="";
 renderFriends();
}

function renderFriends(){
 document.getElementById("friendList").innerHTML=
 friends.map((x,i)=>`
 <div class="item">
 <span>👤 ${safe(x)}</span>
 <button onclick="removeFriend(${i})">ลบ</button>
 </div>
 `).join("");

 document.getElementById("friends").textContent=friends.length;
}

function removeFriend(i){
 friends.splice(i,1);
 localStorage.setItem("friends",JSON.stringify(friends));
 renderFriends();
}

/* TODO */
function addTodo(){
 const input=document.getElementById("todoInput");
 const text=input.value.trim();

 if(!text)return;

 todos.push({
  text:text,
  done:false
 });

 localStorage.setItem("todos",JSON.stringify(todos));

 input.value="";
 renderTodos();
}

function renderTodos(){
 document.getElementById("todoList").innerHTML=
 todos.map((x,i)=>`
 <div class="item ${x.done?"done":""}">
 <span>☑️ ${safe(x.text)}</span>
 <div>
 <button onclick="doneTodo(${i})">✓</button>
 <button onclick="removeTodo(${i})">ลบ</button>
 </div>
 </div>
 `).join("");

 document.getElementById("tasks").textContent=
 todos.filter(x=>!x.done).length;
}

function doneTodo(i){
 todos[i].done=!todos[i].done;
 localStorage.setItem("todos",JSON.stringify(todos));
 renderTodos();
}

function removeTodo(i){
 todos.splice(i,1);
 localStorage.setItem("todos",JSON.stringify(todos));
 renderTodos();
}

/* NOTES */
function addNote(){
 const title=document.getElementById("noteTitle").value.trim();
 const text=document.getElementById("noteText").value.trim();

 if(!title&&!text)return;

 notes.push({title,text});

 localStorage.setItem("notes",JSON.stringify(notes));

 document.getElementById("noteTitle").value="";
 document.getElementById("noteText").value="";

 renderNotes();
}

function renderNotes(){
 document.getElementById("noteList").innerHTML=
 notes.map((x,i)=>`
 <div class="card">
 <h3>${safe(x.title)}</h3>
 <p>${safe(x.text)}</p>
 <button onclick="removeNote(${i})">ลบ</button>
 </div>
 `).join("");
}

function removeNote(i){
 notes.splice(i,1);
 localStorage.setItem("notes",JSON.stringify(notes));
 renderNotes();
}

/* EVENTS */
function addEvent(){
 const date=document.getElementById("eventDate").value;
 const text=document.getElementById("eventText").value.trim();

 if(!date||!text)return;

 events.push({date,text});

 localStorage.setItem("events",JSON.stringify(events));

 document.getElementById("eventText").value="";

 renderEvents();
}

function renderEvents(){
 document.getElementById("eventList").innerHTML=
 events.map((x,i)=>`
 <div class="item">
 <span>📅 ${x.date} — ${safe(x.text)}</span>
 <button onclick="removeEvent(${i})">ลบ</button>
 </div>
 `).join("");
}

function removeEvent(i){
 events.splice(i,1);
 localStorage.setItem("events",JSON.stringify(events));
 renderEvents();
}

/* COUNTDOWN */
let countdownInterval;

function startCountdown(){

 clearInterval(countdownInterval);

 const target=new Date(
  document.getElementById("targetDate").value
 ).getTime();

 if(!target)return;

 function update(){

  const diff=target-Date.now();

  if(diff<=0){
   document.getElementById("timer").textContent="หมดเวลา 🎉";
   clearInterval(countdownInterval);
   return;
  }

  const d=Math.floor(diff/86400000);
  const h=Math.floor(diff%86400000/3600000);
  const m=Math.floor(diff%3600000/60000);
  const s=Math.floor(diff%60000/1000);

  document.getElementById("timer").textContent=
   `${d} วัน ${String(h).padStart(2,"0")}:${String(m).padStart(2,"0")}:${String(s).padStart(2,"0")}`;
 }

 update();
 countdownInterval=setInterval(update,1000);
}

/* GPS */
function locationGPS(){

 const result=document.getElementById("gpsResult");

 if(!navigator.geolocation){
  result.textContent="เบราว์เซอร์ไม่รองรับ GPS";
  return;
 }

 result.textContent="กำลังขอสิทธิ์ตำแหน่ง...";

 navigator.geolocation.getCurrentPosition(
  position=>{
   result.innerHTML=
   `📍 Latitude: ${position.coords.latitude.toFixed(5)}
   <br>
   📍 Longitude: ${position.coords.longitude.toFixed(5)}
   <br>
   🎯 ความแม่นยำประมาณ ${Math.round(position.coords.accuracy)} เมตร`;
  },
  error=>{
   result.textContent="ไม่สามารถเข้าถึงตำแหน่งได้";
  }
 );
}

/* DEVICE */
async function battery(){

 if(!navigator.getBattery){
  document.getElementById("battery").textContent=
   "🔋 เบราว์เซอร์ไม่รองรับข้อมูลแบตเตอรี่";
  return;
 }

 try{
  const b=await navigator.getBattery();

  function update(){
   document.getElementById("battery").textContent=
   `🔋 แบตเตอรี่ ${Math.round(b.level*100)}%
   ${b.charging?"⚡ กำลังชาร์จ":"🔌 ไม่ได้ชาร์จ"}`;
  }

  update();

  b.addEventListener("levelchange",update);
  b.addEventListener("chargingchange",update);

 }catch{
  document.getElementById("battery").textContent=
   "ไม่สามารถอ่านข้อมูลแบตเตอรี่ได้";
 }
}

/* GAME */
function guess(){

 const value=Number(document.getElementById("guess").value);

 if(value<1||value>10){
  document.getElementById("gameResult").textContent=
   "กรุณาใส่เลข 1–10";
  return;
 }

 const answer=Math.floor(Math.random()*10)+1;

 if(value===answer){

  score+=10;

  document.getElementById("gameResult").textContent=
   `🎉 ถูกต้อง! เลขคือ ${answer} +10 คะแนน`;

 }else{

  document.getElementById("gameResult").textContent=
   `❌ ไม่ถูก เลขที่สุ่มคือ ${answer}`;

 }

 localStorage.setItem("score",score);

 updateScore();
}

function updateScore(){
 document.getElementById("score").textContent=score;
 document.getElementById("gameScore").textContent=score;
}

/* PROFILE */
function saveProfile(){

 const name=document.getElementById("name").value.trim();
 const status=document.getElementById("status").value.trim();

 localStorage.setItem(
  "profile",
  JSON.stringify({name,status})
 );

 document.getElementById("welcome").textContent=
  `สวัสดี ${name||"👋"}`;

 document.getElementById("profileResult").innerHTML=
 `
 <div class="profile">
  <div class="avatar">👤</div>
  <div>
   <h2>${safe(name||"ผู้ใช้")}</h2>
   <p>${safe(status||"ไม่มีสถานะ")}</p>
  </div>
 </div>
 `;
}

/* SECURITY */
function safe(text){
 return String(text)
 .replaceAll("&","&amp;")
 .replaceAll("<","&lt;")
 .replaceAll(">","&gt;")
 .replaceAll('"',"&quot;")
 .replaceAll("'","&#039;");
}

/* CLOCK */
setInterval(()=>{

 const now=new Date();

 document.getElementById("clock").textContent=
  now.toLocaleTimeString("th-TH");

 document.getElementById("deviceClock").textContent=
  now.toLocaleString("th-TH");

},1000);

/* START */
document.getElementById("screen").textContent=
 `${screen.width} × ${screen.height}`;

document.getElementById("browser").textContent=
 navigator.userAgent.split(")")[0]+")";

const profile=JSON.parse(
 localStorage.getItem("profile")||"null"
);

if(profile){
 document.getElementById("name").value=profile.name||"";
 document.getElementById("status").value=profile.status||"";
 document.getElementById("welcome").textContent=
  `สวัสดี ${profile.name||"👋"}`;
}

renderChat();
renderFriends();
renderTodos();
renderNotes();
renderEvents();
updateScore();
battery();

</script>

</body>
</html>
