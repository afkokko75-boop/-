function ChatView({ partner, user, accentBg }) {
  const [messages, setMessages] = useState([
    { id: 1, sender: 'partner', text: 'มอนิ่งครับตื่นยังเอ่ย? ❤️', time: '08:30 น.', isPinned: true },
    { id: 2, sender: 'me', text: 'ตื่นแล้วค่า กำลังจะกินข้าวเช้า 🍳', time: '08:32 น.', isPinned: false },
    { id: 3, sender: 'partner', text: 'อย่าลืมกินยาลดไข้ด้วยน้า เป็นห่วงนะครับ', time: '08:33 น.', isPinned: false },
  ]);
  const [inputText, setInputText] = useState('');
  const [searchQuery, setSearchQuery] = useState('');

  const handleSend = () => {
    if (!inputText.trim()) return;
    setMessages([...messages, {
      id: Date.now(),
      sender: 'me',
      text: inputText,
      time: 'เมื่อสักครู่',
      isPinned: false
    }]);
    setInputText('');
  };

  const togglePin = (id) => {
    setMessages(messages.map(m => m.id === id ? { ...m, isPinned: !m.isPinned } : m));
  };

  const deleteMsg = (id) => {
    setMessages(messages.filter(m => m.id !== id));
  };

  const filteredMessages = messages.filter(m => m.text.toLowerCase().includes(searchQuery.toLowerCase()));

  return (
    <div className="h-[calc(100vh-140px)] flex flex-col rounded-3xl bg-slate-900/80 border border-slate-800 overflow-hidden backdrop-blur-md">
      {/* Chat Topbar */}
      <div className="p-4 border-b border-slate-800 flex justify-between items-center bg-slate-950/40">
        <div className="flex items-center gap-3">
          <img src={partner.avatar} className="w-10 h-10 rounded-full object-cover ring-2 ring-violet-500/40" />
          <div>
            <h3 className="text-xs font-bold text-slate-200">{partner.name}</h3>
            <p className="text-[10px] text-emerald-400 flex items-center gap-1">
              <span className="w-1.5 h-1.5 rounded-full bg-emerald-400" /> กำลังพิมพ์...
            </p>
          </div>
        </div>

        {/* Search Msg */}
        <div className="relative w-36 md:w-48">
          <Search className="w-3.5 h-3.5 text-slate-500 absolute left-2.5 top-2.5" />
          <input 
            type="text" 
            placeholder="ค้นหาข้อความ..." 
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            className="w-full bg-slate-800/80 border border-slate-700/60 rounded-xl pl-8 pr-3 py-1 text-xs text-slate-200 focus:outline-none focus:border-violet-500"
          />
        </div>
      </div>

      {/* Pinned Message Bar */}
      {messages.some(m => m.isPinned) && (
        <div className="px-4 py-2 bg-violet-950/30 border-b border-violet-500/20 flex items-center justify-between text-xs text-violet-300">
          <div className="flex items-center gap-2 truncate">
            <Pin className="w-3.5 h-3.5 text-violet-400 fill-violet-400" />
            <span className="truncate">{messages.find(m => m.isPinned)?.text}</span>
          </div>
          <span className="text-[10px] text-violet-400/70 shrink-0">ข้อความปักหมุด</span>
        </div>
      )}

      {/* Message List */}
      <div className="flex-1 overflow-y-auto p-4 space-y-3">
        {filteredMessages.map((msg) => (
          <div 
            key={msg.id} 
